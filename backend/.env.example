# ---------------------------------------------------------------------------
# 复制本文件为 .env.local，填入真实值，然后用 .\run.ps1 启动后端。
# run.ps1 会把这些 KEY=VALUE 注入当前进程的环境变量，
# 避免「在别的窗口 export 了、启动时却读不到」这类问题。
# ---------------------------------------------------------------------------

# ---- 大模型总结（DeepSeek）----
DEEPSEEK_API_KEY=sk-替换成你的-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---- 画面理解（无人讲解的视频：游戏集锦 / 比赛 / 风景）----
# 需要本机有 ffmpeg；下面两行指向 conda zsl 环境里的 ffmpeg，避免依赖 PATH
QVIDEO_FFMPEG_PATH=D:\anaconda\envs\zsl\Library\bin\ffmpeg.exe
QVIDEO_FFPROBE_PATH=D:\anaconda\envs\zsl\Library\bin\ffprobe.exe
QVIDEO_VISION_PROVIDER=openai
QVIDEO_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QVIDEO_VISION_API_KEY=sk-替换成你的-阿里云百炼-key
QVIDEO_VISION_MODEL=qwen3-vl-plus
# 抽多少帧：每帧=一次图片输入，直接影响花费
QVIDEO_VISION_MAX_FRAMES=8

# ---- 语音识别（只有“有人讲解”的视频才需要）----
QVIDEO_ASR_PROVIDER=none
# QVIDEO_ASR_PROVIDER=openai
# QVIDEO_ASR_BASE_URL=https://api.openai.com/v1
# QVIDEO_ASR_API_KEY=
# QVIDEO_ASR_MODEL=whisper-1
# 或用本地 whisper（装好后填命令模板）：
# QVIDEO_ASR_PROVIDER=command
# QVIDEO_ASR_COMMAND=whisper --model small --language {language} --output_format srt --output_dir {outDir} {file}

# ---- 中间件（docker compose 全量启动后打开）----
# QVIDEO_REDIS_ENABLED=true
# QVIDEO_MQ_ENABLED=true

# ---- MySQL（默认 localhost:3306/qavideo，root/root）----
# MYSQL_URL=jdbc:mysql://localhost:3306/qavideo?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# MYSQL_USER=root
# MYSQL_PASSWORD=root
